{
  "name": "n8n-nodes-justtranscribe",
  "version": "0.1.1",
  "description": "n8n community node for JustTranscribe \u2014 transcribe audio/video files and public video links (YouTube, TikTok, Instagram, WhatsApp voice notes) into timestamped text, with speaker labels, 111-language translation and SRT/TXT/DOCX exports",
  "keywords": [
    "n8n-community-node-package",
    "justtranscribe",
    "transcription",
    "speech-to-text",
    "whisper",
    "subtitles",
    "srt",
    "whatsapp",
    "youtube",
    "audio",
    "video",
    "spanish"
  ],
  "license": "MIT",
  "homepage": "https://justtranscribe.ai/developers",
  "author": {
    "name": "Bramonti Ventures",
    "email": "bramontiventures@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bramontiventures/n8n-nodes-justtranscribe.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JustTranscribeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JustTranscribe/JustTranscribe.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.29.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.29.0",
    "n8n-workflow": "^2.16.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.2"
  }
}
